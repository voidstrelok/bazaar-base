# Stage 1: Build
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .

ARG VITE_API_URL=
ARG VITE_STORE_NAME=Bazaar
ARG VITE_STORE_DESCRIPTION=
ARG VITE_STORE_INSTAGRAM=
ARG VITE_STORE_FACEBOOK=
ARG VITE_STORE_TWITTER=
ARG VITE_STORE_WHATSAPP=
ARG VITE_COLOR_PRIMARY=#6366f1
ARG VITE_COLOR_SECONDARY=#f59e0b
ARG VITE_PAYMENT_GATEWAY=transbank
ARG VITE_ENABLE_CHECKOUT=true
ARG VITE_CONTACT_TYPE=none
ARG VITE_CONTACT_VALUE=
ARG VITE_CONTACT_MESSAGE=Hola, me interesa el producto: {nombre}

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_STORE_NAME=$VITE_STORE_NAME
ENV VITE_STORE_DESCRIPTION=$VITE_STORE_DESCRIPTION
ENV VITE_STORE_INSTAGRAM=$VITE_STORE_INSTAGRAM
ENV VITE_STORE_FACEBOOK=$VITE_STORE_FACEBOOK
ENV VITE_STORE_TWITTER=$VITE_STORE_TWITTER
ENV VITE_STORE_WHATSAPP=$VITE_STORE_WHATSAPP
ENV VITE_COLOR_PRIMARY=$VITE_COLOR_PRIMARY
ENV VITE_COLOR_SECONDARY=$VITE_COLOR_SECONDARY
ENV VITE_PAYMENT_GATEWAY=$VITE_PAYMENT_GATEWAY
ENV VITE_ENABLE_CHECKOUT=$VITE_ENABLE_CHECKOUT
ENV VITE_CONTACT_TYPE=$VITE_CONTACT_TYPE
ENV VITE_CONTACT_VALUE=$VITE_CONTACT_VALUE
ENV VITE_CONTACT_MESSAGE=$VITE_CONTACT_MESSAGE

RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine AS final
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
