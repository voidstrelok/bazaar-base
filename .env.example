# Configuracion principal de Bazaar
# Copia este archivo como .env y reemplaza los valores de ejemplo.

# -----------------------------------------------------------------------------
# IDENTIDAD DE LA TIENDA
# -----------------------------------------------------------------------------
STORE_NAME=Bazaar
STORE_DESCRIPTION=Tu tienda, tu identidad.
STORE_INSTAGRAM=
STORE_FACEBOOK=
STORE_TWITTER=
STORE_WHATSAPP=

# -----------------------------------------------------------------------------
# APARIENCIA
# -----------------------------------------------------------------------------
COLOR_PRIMARY=#6366f1
COLOR_SECONDARY=#f59e0b

# -----------------------------------------------------------------------------
# RED Y URLS
# Cambia los puertos por cliente si hay varias instancias en el mismo host.
# En produccion usa el dominio HTTPS del cliente.
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
API_PORT=5000

# Requerida cuando ENABLE_CHECKOUT=true en produccion.
PUBLIC_BASE_URL=https://mitienda.example

# Vacio para usar el mismo origen (/api) detras de Nginx.
# Configuralo solo si la API esta desplegada en otro origen.
VITE_API_URL=

# -----------------------------------------------------------------------------
# BASE DE DATOS
# DB_PORT no se configura aqui: Compose conecta internamente al puerto 5432.
# -----------------------------------------------------------------------------
DB_NAME=Bazaar-Dev
POSTGRES_PASSWORD=change-me-strong-password

# -----------------------------------------------------------------------------
# JWT
# JWT_SECRET debe tener al menos 32 caracteres.
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-development-secret-at-least-32-chars
JWT_ISSUER=TiendaApi
JWT_AUDIENCE=TiendaApiUsers
JWT_EXPIRY_MINUTES=60

# -----------------------------------------------------------------------------
# PAGOS (transbank | mercadopago)
# Configura solo las credenciales del gateway seleccionado.
# -----------------------------------------------------------------------------
PAYMENT_GATEWAY=transbank

# Transbank (solo si PAYMENT_GATEWAY=transbank)
# TRANSBANK_ENVIRONMENT: Integration | Certification | Production
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENVIRONMENT=Integration

# Mercado Pago (solo si PAYMENT_GATEWAY=mercadopago)
MERCADOPAGO_ACCESS_TOKEN=
# Requerido para checkout en produccion.
MERCADOPAGO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# ALMACENAMIENTO (cloudinary | local)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local

# Solo si STORAGE_PROVIDER=cloudinary.
CLOUDINARY_URL=

# Solo si STORAGE_PROVIDER=local.
LOCAL_STORAGE_PATH=/app/uploads

# -----------------------------------------------------------------------------
# CORS
# Usa una lista separada por comas si hay mas de un origen.
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://mitienda.example

# -----------------------------------------------------------------------------
# ADMINISTRADOR INICIAL
# Se usa solo para crear el primer usuario administrador.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@mitienda.example
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NOMBRE=Administrador

# Mantener en false en produccion.
SEED_DEMO_DATA=false

# -----------------------------------------------------------------------------
# EMAIL (Resend, opcional)
# Sin estas variables la API omite el envio de correos.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# FUNCIONALIDADES
# -----------------------------------------------------------------------------
ENABLE_CHECKOUT=true

# Boton de contacto cuando ENABLE_CHECKOUT=false.
# CONTACT_TYPE: whatsapp | email | none
CONTACT_TYPE=none
CONTACT_VALUE=
CONTACT_MESSAGE=Hola, me interesa el producto: {nombre}
