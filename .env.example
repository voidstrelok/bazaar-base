# ─────────────────────────────────────────────
#  IDENTIDAD DE LA TIENDA
# ─────────────────────────────────────────────
STORE_NAME=Bazaar
STORE_DESCRIPTION=Tu tienda, tu identidad.
STORE_INSTAGRAM=thepit.cl
STORE_FACEBOOK=
STORE_TWITTER=
STORE_WHATSAPP=+56945795633

# ─────────────────────────────────────────────
#  APARIENCIA
# ─────────────────────────────────────────────
COLOR_PRIMARY=#6366f1
COLOR_SECONDARY=#f59e0b

# ─────────────────────────────────────────────
#  PUERTOS  (cambiar por cliente para evitar conflictos)
#  En producción usar el dominio público HTTPS.
# ─────────────────────────────────────────────
FRONTEND_PORT=3000
API_PORT=5000

# ─────────────────────────────────────────────
#  BASE DE DATOS
# ─────────────────────────────────────────────
DB_NAME=Bazaar-Dev
POSTGRES_PASSWORD=change-me-strong-password

# URLs públicas
PUBLIC_BASE_URL=https://mitienda.example
VITE_API_URL=

# ─────────────────────────────────────────────
#  JWT
# ─────────────────────────────────────────────
JWT_SECRET=change-me-development-secret-at-least-32-chars
JWT_ISSUER=TiendaApi
JWT_AUDIENCE=TiendaApiUsers
JWT_EXPIRY_MINUTES=60

# ─────────────────────────────────────────────
#  PAGOS  (transbank | mercadopago)
# ─────────────────────────────────────────────
PAYMENT_GATEWAY=transbank

# Transbank  (TRANSBANK_ENVIRONMENT: Integration | Certification | Production)
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENVIRONMENT=Production

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
#  ALMACENAMIENTO  (cloudinary | local)
# ─────────────────────────────────────────────
STORAGE_PROVIDER=cloudinary
CLOUDINARY_URL=
LOCAL_STORAGE_PATH=/app/uploads

# ─────────────────────────────────────────────
#  CORS
# ─────────────────────────────────────────────
CORS_ORIGINS=https://mitienda.example

# ─────────────────────────────────────────────
#  ADMINISTRADOR INICIAL (seed)
# ─────────────────────────────────────────────
ADMIN_EMAIL=admin@mitienda.example
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NOMBRE=Administrador

# Datos demo; mantener en false en producción
SEED_DEMO_DATA=false

# ─────────────────────────────────────────────
#  EMAIL  (Resend)
# ─────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─────────────────────────────────────────────
#  FUNCIONALIDADES
# ─────────────────────────────────────────────
ENABLE_CHECKOUT=true

# Botón de contacto cuando ENABLE_CHECKOUT=false
# CONTACT_TYPE: whatsapp | email | none
CONTACT_TYPE=whatsapp
CONTACT_VALUE=56912345678
CONTACT_MESSAGE=Hola, me interesa el producto:
